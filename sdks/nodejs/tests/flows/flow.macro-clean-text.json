{
  "description": "Second macro shape: clean-text. Asserts the macro path produces a non-empty string output.",
  "flow": {
    "id": "testMacroClean",
    "metadata": {
      "display_name": "Test: clean-text macro"
    },
    "nodes": [
      {
        "id": "in1",
        "type": "input-data",
        "settings": {
          "key": "text",
          "type": "string",
          "default_value": ""
        }
      },
      {
        "id": "macro1",
        "type": "clean-text",
        "settings": {}
      },
      {
        "id": "out1",
        "type": "output-data",
        "settings": {}
      }
    ],
    "links": [
      {
        "from": {
          "node_id": "in1",
          "port_name": "value"
        },
        "to": {
          "node_id": "macro1",
          "port_name": "text"
        }
      },
      {
        "from": {
          "node_id": "macro1",
          "port_name": "cleaned_text"
        },
        "to": {
          "node_id": "out1",
          "port_name": "value"
        }
      }
    ],
    "groups": []
  },
  "inputs": {
    "text": "  Hello    world.  \n\n\n  Second   line.  "
  },
  "expectedSchema": {
    "type": "object",
    "required": [
      "outputs"
    ],
    "properties": {
      "outputs": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    }
  }
}
