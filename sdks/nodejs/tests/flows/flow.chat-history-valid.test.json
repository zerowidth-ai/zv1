{
  "description": "REGRESSION (tool-round-trip): a resent transcript containing VALID prior tool traffic (assistant tool_calls + role:tool response) must pass the middleware chain and reach the provider without a 400.",
  "inputs": {
    "chat": [
      {
        "role": "user",
        "content": "What is 40 + 2? Use your tool."
      },
      {
        "role": "assistant",
        "content": null,
        "tool_calls": [
          {
            "id": "call_h1",
            "type": "function",
            "function": {
              "name": "TestsAddition",
              "arguments": "{\"a\": 40, \"b\": 2}"
            }
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "call_h1",
        "name": "TestsAddition",
        "content": "{\"data\":42}"
      },
      {
        "role": "assistant",
        "content": "It's 42."
      },
      {
        "role": "user",
        "content": "Thanks, that's all correct! As a connection check, please reply with exactly one word: READY"
      }
    ]
  },
  "expectedSchema": {
    "type": "object",
    "required": [
      "outputs"
    ],
    "properties": {
      "outputs": {
        "type": "object",
        "required": [
          "chat"
        ],
        "properties": {
          "chat": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "const": "assistant"
                },
                "content": {
                  "type": "string",
                  "pattern": "READY"
                }
              }
            }
          }
        }
      }
    }
  },
  "retries": 2
}