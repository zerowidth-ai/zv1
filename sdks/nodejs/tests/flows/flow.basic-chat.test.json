{
  "description": "A simon says use of Gemini",
  "inputs": {
    "chat": [
      {
        "role": "user",
        "content": "Repeat these words and only these words back to me: \"Simon says, 'Hello'\""
      }
    ]
  },
  "expectedSchema": {
    "type": "object",
    "required": [
      "outputs"
    ],
    "properties": {
      "outputs": {
        "type": "object",
        "required": [
          "chat"
        ],
        "properties": {
          "chat": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "const": "assistant"
                },
                "content": {
                  "type": "string",
                  "pattern": "Simon says"
                }
              }
            }
          }
        }
      }
    }
  },
  "retries": 2
}